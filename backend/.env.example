# KisanLink Backend Environment Configuration

PORT=3000
JWT_SECRET=replace-with-a-long-random-string
SESSION_MINUTES=60

# --- MySQL Database Configuration ---
# Leave unset or empty to use local JSON file persistence.
# Fill in when deploying to Railway, AWS RDS, Aiven, TiDB Cloud, or local MySQL:

# Option 1: Individual connection parameters (Local / AWS RDS / Aiven / TiDB)
# DB_HOST=localhost
# DB_PORT=3306
# DB_USER=root
# DB_PASSWORD=your_password
# DB_NAME=kisanlink
# DB_SSL=false

# Option 2: Full connection URI (Railway / Render / Heroku)
# MYSQL_URL=mysql://root:password@containers-us-west-1.railway.app:3306/railway
